NEXT_SHARP_PATH=./node_modules/sharp
YOUTUBE_API_KEY=api_key
REVALIDATE_KEY=revalidate_key
RESEND_API_KEY=api_key
# Strapi CMS (BEARER_TOKEN is a Strapi API token, server-only)
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
BEARER_TOKEN=strapi_api_token
# Public site settings (NEXT_PUBLIC_* values are inlined into the client bundle at build time)
# Site name, Twitter and default banner are fallbacks: Strapi Site Settings overrides them once published
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=site_name
NEXT_PUBLIC_TWITTER_HANDLE=@twitter_handle
NEXT_PUBLIC_TWITTER_USER_ID=twitter_user_id
# Optional, defaults to <NEXT_PUBLIC_SITE_URL>/api/og
NEXT_PUBLIC_DEFAULT_BANNER=
# Fallback recipient for the contact form when Strapi Contact Page > form_recipient_email is empty
CONTACT_TO_EMAIL=
# Strapi Preview (theme drafts): shared with the backend's PREVIEW_SECRET, opens /api/preview
PREVIEW_SECRET=preview_secret
# Optional, comma separated: extra origins allowed to frame the site (the Strapi API origin always is)
PREVIEW_ALLOWED_ORIGINS=
